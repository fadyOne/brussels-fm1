{
  "outputDirectory": "public",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/emu/(.*).wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    },
    {
      "source": "/firmware/(.*).fwsc",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" }
      ]
    }
  ]
}
